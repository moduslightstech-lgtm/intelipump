[Unit]
Description=InteliPump FDC Controller - LAB LISTEN_ONLY
Documentation=file:///home/intelipump/intelipump/intelipump-fdc/docs/phase-11-deployment-hardening.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main

User=intelipump
Group=intelipump
SupplementaryGroups=dialout

WorkingDirectory=/home/intelipump/intelipump/intelipump-fdc
EnvironmentFile=-/etc/intelipump/intelipump.env

Environment=PYTHONUNBUFFERED=1
Environment=INTELIPUMP_ENVIRONMENT=LAB
Environment=INTELIPUMP_CONTROLLER__MODE=LISTEN_ONLY
Environment=INTELIPUMP_SAFETY__ACTIVE_COMMANDS_ENABLED=false
Environment=INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
Environment=INTELIPUMP_MQTT__ENABLED=false
Environment=INTELIPUMP_WATCHDOG__ENABLED=true

ExecStart=/home/intelipump/intelipump/intelipump-fdc/venv/bin/intelipump-controller \
  --port /dev/intelipump-controller \
  --addresses 1,2 \
  --baud 9600 \
  --mode LISTEN_ONLY \
  --response-timeout-ms 100 \
  --database-url sqlite+aiosqlite:////var/lib/intelipump/intelipump.db \
  --show-recovery-report

WatchdogSec=30s
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intelipump

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target