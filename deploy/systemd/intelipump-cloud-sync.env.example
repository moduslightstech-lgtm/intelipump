# Publish-only sidecar. Copy to /etc/intelipump/intelipump-cloud-sync.env
# Do not enable MQTT or command subscription on intelipump.service.

INTELIPUMP_ENVIRONMENT=LAB
INTELIPUMP_CONTROLLER__STATION_ID=InteliPump-US-Lab
INTELIPUMP_CONTROLLER__DEVICE_ID=InteliPump-Lab-pi-001
INTELIPUMP_CONTROLLER__MODE=BENCH_CONTROL

INTELIPUMP_DATABASE__URL=sqlite+aiosqlite:////var/lib/intelipump/intelipump.db

INTELIPUMP_MQTT__ENABLED=true
INTELIPUMP_MQTT__HOST=157.230.215.93
INTELIPUMP_MQTT__PORT=1883
INTELIPUMP_MQTT__USERNAME=pumpuser
INTELIPUMP_MQTT__PASSWORD=
INTELIPUMP_MQTT__COMMAND_SUBSCRIPTION_ENABLED=false
INTELIPUMP_MQTT__TLS_ENABLED=false
INTELIPUMP_MQTT__CLIENT_ID=InteliPump-Lab-pi-001-sync

INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
INTELIPUMP_API__SIMULATED=false

# Optional. If set, the file must exist on the Pi.
# US Lab can omit this — embedded map is: address 2 → pump-1/nozzle-2.
# INTELIPUMP_CHANNEL_MAP_PATH=/home/intelipump/intelipump/intelipump-fdc/config/channel_map.us-lab.json
