# SAO Redeemed Station 1 — cloud sync with command subscribe for SET_PRICE only.
# intelipump.service stays MQTT-off and is the only RS-485 master.
# Remote AUTHORIZE remains disabled.

[Unit]
Description=InteliPump cloud sync - SAO Redeemed Station 1 (prod)
Documentation=file:///home/intelipump/intelipump/intelipump-fdc/docs/cloud/message-schemas.md
After=network-online.target intelipump.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=intelipump
Group=intelipump

WorkingDirectory=/home/intelipump/intelipump/intelipump-fdc
EnvironmentFile=-/etc/intelipump/intelipump.env
EnvironmentFile=-/etc/intelipump/intelipump-cloud-sync.env

Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/intelipump/.local/bin:/usr/bin:/bin
Environment=INTELIPUMP_ENVIRONMENT=PRODUCTION
Environment=INTELIPUMP_MQTT__ENABLED=true
Environment=INTELIPUMP_MQTT__COMMAND_SUBSCRIPTION_ENABLED=true
Environment=INTELIPUMP_MQTT__ALLOW_PRODUCTION_REMOTE_SET_PRICE=true
Environment=INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
Environment=INTELIPUMP_API__SIMULATED=false

ExecStart=/home/intelipump/intelipump/intelipump-fdc/.venv/bin/intelipump-cloud-sync \
  --database-url sqlite+aiosqlite:////var/lib/intelipump/intelipump.db \
  --device-id InteliPump-SAO-RS1-pi-001 \
  --station-id SAO-Redeemed-Station-1 \
  --commands-enabled \
  --confirm-production-remote-set-price

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intelipump-cloud-sync

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
