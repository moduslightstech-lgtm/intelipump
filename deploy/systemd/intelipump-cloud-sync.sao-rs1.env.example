# SAO Redeemed Station 1 — publish-only cloud sync (prod topics).
# Copy to /etc/intelipump/intelipump-cloud-sync.env and set MQTT password.
# Same Mosquitto broker as lab; isolation is intelipump/prod/... + stationId.

INTELIPUMP_ENVIRONMENT=PRODUCTION

INTELIPUMP_CHANNEL_MAP_PATH=/home/intelipump/intelipump/intelipump-fdc/config/channel_map.sao-rs1.json

INTELIPUMP_CONTROLLER__STATION_ID=SAO-Redeemed-Station-1
INTELIPUMP_CONTROLLER__DEVICE_ID=InteliPump-SAO-RS1-pi-001
INTELIPUMP_CONTROLLER__MODE=BENCH_CONTROL

INTELIPUMP_DATABASE__URL=sqlite+aiosqlite:////var/lib/intelipump/intelipump.db

INTELIPUMP_MQTT__ENABLED=true
INTELIPUMP_MQTT__HOST=157.230.215.93
INTELIPUMP_MQTT__PORT=1883
INTELIPUMP_MQTT__USERNAME=pumpuser
INTELIPUMP_MQTT__PASSWORD=
INTELIPUMP_MQTT__COMMAND_SUBSCRIPTION_ENABLED=false
INTELIPUMP_MQTT__TLS_ENABLED=false
INTELIPUMP_MQTT__CLIENT_ID=InteliPump-SAO-RS1-pi-001-sync

INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
INTELIPUMP_API__SIMULATED=false
