# SAO Redeemed Station 1 — day-1 pump (authorize-on-lift).
# Install to /etc/intelipump/intelipump.env
# Controller stays MQTT-off; cloud-sync publishes to prod topics.

INTELIPUMP_ENVIRONMENT=PRODUCTION
INTELIPUMP_CONTROLLER__MODE=BENCH_CONTROL
INTELIPUMP_CONTROLLER__STATION_ID=SAO-Redeemed-Station-1
INTELIPUMP_CONTROLLER__DEVICE_ID=InteliPump-SAO-RS1-pi-001

INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
INTELIPUMP_SAFETY__REQUIRE_PHYSICAL_CONTROL_ENABLE=true

INTELIPUMP_DART__SERIAL_PORT=/dev/ttyUSB0
INTELIPUMP_DART__BAUD_RATE=9600

INTELIPUMP_DATABASE__URL=sqlite+aiosqlite:////var/lib/intelipump/intelipump.db

INTELIPUMP_MQTT__ENABLED=false

INTELIPUMP_WATCHDOG__ENABLED=true
INTELIPUMP_WATCHDOG__STATUS_INTERVAL_S=15
