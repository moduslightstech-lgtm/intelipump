# SAO Redeemed Station 1 — physical pump 2 on a dedicated Pi / RS-485 bus.
# DART addresses 1,2 → pump-2 / nozzle-1 / nozzle-2, PMS @ 1400.
# Do NOT share this bus with InteliPump-SAO-RS1-pi-001 (one master per bus).
#
# Install via: ./scripts/install_sao_rs1_pump2_pi.sh --confirm-sao-authorize-install --start

[Unit]
Description=InteliPump FDC Controller - SAO RS1 pump-2 (BENCH_CONTROL)
Documentation=file:///home/intelipump/intelipump/intelipump-fdc/docs/phase-11-deployment-hardening.md
After=network-online.target
Wants=network-online.target
After=dev-ttyUSB0.device
Wants=dev-ttyUSB0.device
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main

User=intelipump
Group=intelipump
SupplementaryGroups=dialout

WorkingDirectory=/home/intelipump/intelipump/intelipump-fdc
EnvironmentFile=-/etc/intelipump/intelipump.env

Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/intelipump/.local/bin:/usr/bin:/bin
Environment=INTELIPUMP_ENVIRONMENT=PRODUCTION
Environment=INTELIPUMP_CONTROLLER__MODE=BENCH_CONTROL
Environment=INTELIPUMP_CONTROLLER__STATION_ID=SAO-Redeemed-Station-1
Environment=INTELIPUMP_CONTROLLER__DEVICE_ID=InteliPump-SAO-RS1-pi-002
Environment=INTELIPUMP_CHANNEL_MAP_PATH=/home/intelipump/intelipump/intelipump-fdc/config/channel_map.sao-rs1-pump2.json
Environment=INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
Environment=INTELIPUMP_MQTT__ENABLED=false
Environment=INTELIPUMP_WATCHDOG__ENABLED=true

ExecStart=/home/intelipump/intelipump/intelipump-fdc/.venv/bin/intelipump-controller \
  --port /dev/ttyUSB0 \
  --addresses 1,2 \
  --baud 9600 \
  --mode BENCH_CONTROL \
  --response-timeout-ms 200 \
  --confirm-owned-lab-dispense-session \
  --confirm-production-sole-controller-dispense \
  --enable-active-commands \
  --confirm-physical-control-enable \
  --price 1400 \
  --hold-display-until-lift \
  --logical-nozzle-count 1 \
  --confirm-logical-nozzle-mapping \
  --confirm-price-scale-raw-bcd \
  --database-url sqlite+aiosqlite:////var/lib/intelipump/intelipump.db

WatchdogSec=30s
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intelipump

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
