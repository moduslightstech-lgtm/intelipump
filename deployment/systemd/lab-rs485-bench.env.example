# LAB-only environment for intelipump-rs485-bench.service
# Copy to /etc/intelipump/lab-rs485-bench.env (mode 0640, root:intelipump).
# Prefer /dev/serial/by-id paths. Never enable active commands here.

INTELIPUMP_ENVIRONMENT=LAB
INTELIPUMP_CONTROLLER__MODE=LISTEN_ONLY
INTELIPUMP_SAFETY__ACTIVE_COMMANDS_ENABLED=false
INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
INTELIPUMP_BENCH__NAME=us-office-rs485-01
INTELIPUMP_BENCH__CONTROLLER_PORT=/dev/serial/by-id/REPLACE-CONTROLLER
INTELIPUMP_BENCH__SIMULATOR_PORT=/dev/serial/by-id/REPLACE-SIMULATOR
INTELIPUMP_BENCH__DURATION_S=300
INTELIPUMP_BENCH__RESPONSE_TIMEOUT_MS=100
INTELIPUMP_BENCH__PROTOCOL_TARGET_MS=25
INTELIPUMP_BENCH__TERMINATION_ENABLED=false
INTELIPUMP_BENCH__BIAS_ENABLED=false
