INTELIPUMP_ENVIRONMENT=LAB
INTELIPUMP_CONTROLLER__MODE=LISTEN_ONLY
INTELIPUMP_CONTROLLER__DEVICE_ID=InteliPump-Lab-pi-001
INTELIPUMP_CONTROLLER__STATION_ID=InteliPump-US-Lab
INTELIPUMP_DART__SERIAL_PORT=/tmp/dart-controller
INTELIPUMP_DART__BAUD_RATE=9600
INTELIPUMP_DART__DATA_BITS=8
INTELIPUMP_DART__PARITY=ODD
INTELIPUMP_DART__STOP_BITS=1
INTELIPUMP_DART__RESPONSE_TIMEOUT_MS=25
INTELIPUMP_SAFETY__ACTIVE_COMMANDS_ENABLED=false
INTELIPUMP_SAFETY__REMOTE_AUTHORIZATION_ENABLED=false
INTELIPUMP_SAFETY__REQUIRE_PHYSICAL_CONTROL_ENABLE=true
INTELIPUMP_DATABASE__URL=sqlite+aiosqlite:///./data/intelipump.db
INTELIPUMP_MQTT__ENABLED=false
INTELIPUMP_MQTT__HOST=127.0.0.1
INTELIPUMP_MQTT__PORT=1883
INTELIPUMP_MQTT__USERNAME=
INTELIPUMP_MQTT__PASSWORD=
# Phase 10 RS-485 office bench (prefer /dev/serial/by-id/... on Linux)
INTELIPUMP_BENCH__NAME=us-office-rs485-01
INTELIPUMP_BENCH__CONTROLLER_PORT=
INTELIPUMP_BENCH__SIMULATOR_PORT=
INTELIPUMP_BENCH__RESPONSE_TIMEOUT_MS=100
INTELIPUMP_BENCH__PROTOCOL_TARGET_MS=25
INTELIPUMP_BENCH__AUTOMATIC_DIRECTION_CONTROL=true
INTELIPUMP_BENCH__TERMINATION_ENABLED=false
INTELIPUMP_BENCH__BIAS_ENABLED=false
INTELIPUMP_BENCH__GROUND_REFERENCE_CONNECTED=true
